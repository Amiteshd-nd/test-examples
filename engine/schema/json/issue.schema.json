{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": ["error", "warning", "info"]
    },
    "category": {
      "type": "string",
      "enum": ["bylaw", "geometry", "brief", "vastu", "schema"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "object_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "how_to_fix": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    }
  },
  "required": ["rule_id", "severity", "category", "message", "object_ids", "how_to_fix", "source"],
  "additionalProperties": false
}
