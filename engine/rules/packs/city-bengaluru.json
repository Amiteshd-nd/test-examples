{
  "format": "plancraft-rule-pack",
  "version": 1,
  "id": "city-bengaluru",
  "name": "Bengaluru (BBMP) bylaws",
  "description": "Setbacks, ground coverage and FAR for Bengaluru. The tables are empty until the architect adds the BBMP values; empty rules check nothing.",
