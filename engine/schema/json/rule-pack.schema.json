{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "plancraft-rule-pack"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "applies": {
      "type": "string",
      "enum": ["always", "vastu"]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "properties": {
              "room_type": {
                "type": "string",
                "enum": [
                  "living",
                  "family_lounge",
                  "dining",
                  "kitchen",
                  "bedroom",
                  "master_bedroom",
                  "dress",
                  "toilet",
                  "bath",
                  "wc",
                  "pooja",
                  "utility",
                  "store",
                  "staircase",
                  "lift",
                  "sit_out",
                  "balcony",
                  "parking",
                  "ots",
                  "study",
                  "foyer",
                  "passage",
                  "servant",
                  "duct",
                  "shop_office"
                ]
              },
              "room_types": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "living",
                    "family_lounge",
                    "dining",
                    "kitchen",
                    "bedroom",
                    "master_bedroom",
                    "dress",
                    "toilet",
                    "bath",
                    "wc",
                    "pooja",
                    "utility",
                    "store",
                    "staircase",
                    "lift",
                    "sit_out",
                    "balcony",
                    "parking",
                    "ots",
                    "study",
                    "foyer",
                    "passage",
                    "servant",
                    "duct",
                    "shop_office"
                  ]
                }
              },
              "door": {
                "type": "string",
                "enum": ["entrance", "internal"]
              },
              "side": {
                "type": "string",
                "enum": ["front", "rear", "left", "right"]
              }
            },
            "additionalProperties": false
          },
          "check": {
            "type": "string",
            "enum": [
              "min_area",
              "min_area_one",
              "min_width",
              "min_level_height",
              "zone_in",
              "zone_not_in",
              "entrance_side_in",
              "min_door_width",
              "min_setback",
              "max_coverage",
              "max_far"
            ]
          },
          "value": {
            "type": "number"
          },
          "table": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string",
                "enum": ["plot_area_m2", "plot_width_m", "plot_depth_m", "road_width_m"]
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "upto": {
                      "anyOf": [
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "value": {
                      "type": "number"
                    }
                  },
                  "required": ["upto", "value"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["by", "rows"],
            "additionalProperties": false
          },
          "zones": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "north",
                "north_east",
                "east",
                "south_east",
                "south",
                "south_west",
                "west",
                "north_west",
                "centre"
              ]
            }
          },
          "unit": {
            "type": "string",
            "enum": ["cm", "m2", "%", "ratio", "zone"]
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "info"]
          },
          "category": {
            "type": "string",
            "enum": ["bylaw", "geometry", "brief", "vastu"]
          },
          "source": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "editable": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "scope",
          "check",
          "unit",
          "severity",
          "category",
          "source",
          "verified",
          "editable"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "version", "id", "name", "description", "applies", "rules"],
  "additionalProperties": false
}
