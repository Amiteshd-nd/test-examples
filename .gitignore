test-results/
playwright-report/
*.log
.DS_Store

# Secrets: only .env.example is committed (PRD §3.5).
.env
.env.*
!.env.example

# Plan data stays local; only anonymised samples are committed.
/data/**
!/data/**/
!/data/**/.gitkeep
!/data/**/samples/**

# Python tools (ezdxf checks)
tools/.venv/
__pycache__/

