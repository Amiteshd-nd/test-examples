/design/reference/*.png
/design/reference/*.jpg
/design/reference/*.jpeg
/design/reference/*.webp
/design/reference-3d/*
!/design/reference-3d/README.md
/design/reference-vault/*
!/design/reference-vault/README.md
/design/reference-icons/*
