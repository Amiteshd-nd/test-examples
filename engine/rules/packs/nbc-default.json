  "id": "nbc-default",
  "name": "NBC minimum room sizes",
  "description": "Minimum areas, widths and heights for habitable rooms, kitchens and toilets, from the National Building Code of India 2016, Part 3; values confirmed by the architect on 2026-11-06.",
  "applies": "always",
  "rules": [
    {
      "id": "habitable_room_area_one",
      "label": "Largest habitable room",
      "scope": {
        "room_types": [
          "living",
          "family_lounge",
          "dining",
          "bedroom",
          "master_bedroom",
          "study",
          "servant"
        ]
      },
      "check": "min_area_one",
      "value": 9.5,
      "unit": "m2",
      "severity": "error",
      "category": "bylaw",
      "source": "NBC 2016 Part 3 (confirmed by the architect, 2026-11-06)",
      "verified": true,
      "editable": true,
      "note": "At least one habitable room of 9.5 m²; the others need 7.5 m² (next rule). Habitable rooms: living, family lounge, dining, bedroom, master bedroom, study, servant's room (confirmed by the architect, 2026-11-07)."
    },
